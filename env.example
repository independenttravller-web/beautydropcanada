# Core
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=sqlite:///beautydrop.db
COOKIE_SECURE=0
SESSION_HOURS=8
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
CONTACT_EMAIL=support@example.com

# Taxes: set only after confirming your tax obligations/registration.
# 0.13 = 13% HST, for example. Do not assume this rate applies to your business.
TAX_RATE=0
CURRENCY=cad

# Twilio SMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Private S3-compatible object storage (AWS S3, Cloudflare R2, etc.)
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT_URL=
S3_REGION=auto

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# SMTP email for password resets/contact messages
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=

# Error monitoring
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
PHOTO_RETENTION_DAYS=90
